# Required on the first startup. Remove or rotate after the admin is created.
FLAGSHIP_ADMIN_EMAIL=admin@example.com
FLAGSHIP_ADMIN_PASSWORD=change-this-to-a-long-random-password
FLAGSHIP_PORT=8080

# Used by compose.yml (bundled PostgreSQL).
POSTGRES_DB=flagship
POSTGRES_USER=flagship
POSTGRES_PASSWORD=change-this-database-password
POSTGRES_PORT=5432

# Used by compose.external-db.yml instead of the values above.
# FLAGSHIP_DB_CONNECTION_STRING=Host=postgres.example.internal;Port=5432;Database=flagship;Username=flagship;Password=change-me;SSL Mode=Require
